# Provider mặc định: Groq Cloud AI
AI_PROVIDER=groq

# Tạo API key tại Groq Console và đặt vào GROQ_API_KEY ở máy chạy server.
# KHÔNG commit API key thật vào repository.
GROQ_API_KEY=your_groq_api_key_here
MODEL=llama-3.3-70b-versatile

# Gemini chỉ làm phụ tá cho Groq để tiết kiệm request.
# Không có model chính thức "Gemini 1.6 Flash"; dùng Flash-Lite tiết kiệm chi phí.
# Nếu để trống GEMINI_API_KEY thì assistant tự tắt và app vẫn chạy Groq bình thường.
GEMINI_API_KEY=
GEMINI_ASSISTANT_MODEL=gemini-2.5-flash-lite
# off | fallback | verify | verify_and_fallback
GEMINI_ASSISTANT_MODE=verify_and_fallback
# Chỉ verify tối đa 2 finding ưu tiên mỗi file/lượt quét.
GEMINI_ASSISTANT_MAX_VERIFICATIONS=2
GEMINI_ASSISTANT_VERIFY_SEVERITIES=Nghiêm trọng,Cao,Critical,High
GEMINI_ASSISTANT_CONTEXT_LINES=30
GEMINI_ASSISTANT_MAX_EXCERPT_LINES=180

# Web Server Port
WEB_PORT=3000

# Groq: chạy chunk tuần tự để tránh đụng TPM/RPM.
SCAN_MAX_CONCURRENCY=1
SCAN_SINGLE_LIMIT=400
SCAN_CHUNK_SIZE=450
SCAN_CHUNK_OVERLAP=50
SCAN_LARGE_THRESHOLD=3000
SCAN_MAX_TARGETED_CHUNKS=8
SCAN_MAX_LARGE_CHUNKS=10
SCAN_COVERAGE_SAMPLES=3
SCAN_COVERAGE_SAMPLE_SIZE=300

# Project/folder scanning
PROJECT_SMALL_FILE_LINES=120
PROJECT_BATCH_MAX_LINES=400
PROJECT_MAX_CROSS_FILE_CHECKS=4
PROJECT_SCAN_THROTTLE_MS=150

LANGUAGE=Tiếng Việt
