# OpenAI mặc định cho AI Security Reviewer
# KHÔNG commit API key thật vào repository. Hãy copy file này thành .env ở máy local
# hoặc cấu hình OPENAI_API_KEY trong secret/environment của nền tảng deploy.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_ENDPOINT=https://api.openai.com/v1
MODEL=gpt-5.6-terra

# Web Server Port
WEB_PORT=3000

# Tuỳ chọn ngôn ngữ kết quả trả về
LANGUAGE=Tiếng Việt
