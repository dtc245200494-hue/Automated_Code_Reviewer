# Provider mặc định dùng Gemini qua OpenAI-compatible API của Google
# (Scanner hiện đã dùng thư viện OpenAI-compatible nên không cần cài thêm SDK.)
AI_PROVIDER=openai

# Tạo Gemini API key trong Google AI Studio rồi đặt vào OPENAI_API_KEY ở VPS.
# KHÔNG commit API key thật vào repository.
OPENAI_API_KEY=your_gemini_api_key_here
OPENAI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL=gemini-2.5-pro

# Các provider khác vẫn có thể cấu hình bằng biến tương ứng nếu cần.
# GROQ_API_KEY=your_groq_api_key_here
# OPENCODE_API_KEY=your_opencode_api_key_here
# CEREBRAS_API_KEY=your_cerebras_api_key_here

# Web Server Port
WEB_PORT=3000

# Gemini Pro free tier có rate limit thấp hơn Flash; để 1 request song song cho ổn định.
SCAN_MAX_CONCURRENCY=1

# Tuỳ chọn ngôn ngữ kết quả trả về
LANGUAGE=Tiếng Việt
