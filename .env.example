# Chọn AI Provider rõ ràng: cerebras | opencode | openai | groq | azure | github
AI_PROVIDER=cerebras

# Cerebras là provider mặc định của server khi người dùng chưa thêm API key riêng.
# Tạo key tại Cerebras Cloud rồi đặt vào CEREBRAS_API_KEY.
# KHÔNG commit API key thật vào repository. Hãy copy file này thành .env ở máy local
# hoặc cấu hình trong secret/environment của nền tảng deploy (Render, Railway, VPS...).
CEREBRAS_API_KEY=your_cerebras_api_key_here
OPENAI_API_ENDPOINT=https://api.cerebras.ai/v1
MODEL=gpt-oss-120b

# Các provider khác vẫn có thể cấu hình bằng biến tương ứng nếu cần.
# OPENAI_API_KEY=your_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# OPENCODE_API_KEY=your_opencode_api_key_here

# Web Server Port
WEB_PORT=3000

# Giới hạn số chunk AI chạy đồng thời. 2 là mức an toàn cho free tier.
SCAN_MAX_CONCURRENCY=2

# Tuỳ chọn ngôn ngữ kết quả trả về
LANGUAGE=Tiếng Việt
