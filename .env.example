# OpenCode.ai - Provider mặc định (Nhiều model AI miễn phí xịn)
# KHÔNG commit API key thật vào repository. Hãy copy file này thành .env ở máy local
# hoặc cấu hình trong secret/environment của nền tảng deploy (Render, Railway...).
OPENAI_API_KEY=your_opencode_api_key_here
OPENAI_API_ENDPOINT=https://opencode.ai/zen/v1
MODEL=deepseek-v4-flash-free

# === FREE MODELS trên OpenCode.ai (chọn 1) ===
# deepseek-v4-flash-free       (DeepSeek - nhanh, mạnh)
# muse-spark-1.3-contributor-free
# muse-spark-1.2-contributor-free
# nemotron-3-ultra-free        (NVIDIA)
# nemotron-3.5-lightning-free  (NVIDIA)
# mimo-v2.5-free               (Xiaomi)
# ling-3.0-flash-fin-free

# Web Server Port
WEB_PORT=3000

# Tuỳ chọn ngôn ngữ kết quả trả về
LANGUAGE=Tiếng Việt
