# Chọn AI Provider rõ ràng: opencode | openai | groq | azure | github
AI_PROVIDER=opencode

# Cấu hình API Key và Endpoint tương ứng
# KHÔNG commit API key thật vào repository. Hãy copy file này thành .env ở máy local
# hoặc cấu hình trong secret/environment của nền tảng deploy (Render, Railway, VPS...).
OPENAI_API_KEY=your_api_key_here
OPENAI_API_ENDPOINT=https://opencode.ai/zen/v1

# Khi người dùng CHƯA thêm API key riêng trên giao diện web,
# server sẽ tự xoay vòng/fallback giữa đúng 6 model OpenCode miễn phí sau:
# ling-3.0-flash-fin-free
# muse-spark-1.2-contributor-free
# muse-spark-1.3-contributor-free
# nemotron-3.5-lightning-free
# nemotron-3-ultra-free
# mimo-v2.5-free
# MODEL vẫn được dùng làm fallback cho các luồng chạy trực tiếp ngoài web.
MODEL=ling-3.0-flash-fin-free

# Web Server Port
WEB_PORT=3000

# Tuỳ chọn ngôn ngữ kết quả trả về
LANGUAGE=Tiếng Việt
